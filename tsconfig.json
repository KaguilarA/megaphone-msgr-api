{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "outDir": "dist/compiled",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true,
    "useUnknownInCatchVariables": false,
    "declaration": true,
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "app/**/*.ts",
    "consts/**/*.ts",
    "controllers/**/*.ts",
    "integrations/**/*.ts",
    "middlewares/**/*.ts",
    "models/**/*.ts",
    "routes/**/*.ts",
    "setup/**/*.ts",
    "utils/**/*.ts",
    "scripts/setup.ts",
    "scripts/migrate-phone-numbers.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", "test", "deploy"]
}
