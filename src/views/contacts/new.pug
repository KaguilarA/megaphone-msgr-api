extends ../layout

include ../mixins/phoneSelect
include ../mixins/phoneSection
include ../mixins/emailSection
include ../mixins/addressSection

block content
  .page-header
    h1 Nuevo Contacto
    a.btn.btn-outline-warning(href="/contacts") Cancelar

  .form-container
    form#contactForm(x-data="createContactApp()", @submit.prevent="submitForm")
      .form-section
        h2.section-title Datos Personales
        .form-group
          label(for="name") Nombre Completo *
          input#name.form-control(type="text", x-model="name", required, placeholder="Ej: Juan Pérez")

      +phoneSection()
      +emailSection()
      +addressSection()

      .form-actions
        button.btn.btn-success(type="submit", :disabled="loading")
          span(x-text="loading ? 'Guardando...' : 'Guardar Contacto'")
        a.btn.btn-outline-danger(href="/contacts") Cancelar

block scripts
  script(src="/js/create-contact.js")