extends ../layout

include ../mixins/phoneSelect
include ../mixins/phoneSection
include ../mixins/emailSection
include ../mixins/addressSection

block content
  .page-header
    h1 Editar Contacto
    a.btn.btn-outline-secondary(href="/contacts") Volver a Contactos

  .form-container
    form#contactForm(
      x-data=`editContactApp(${JSON.stringify(contact)})`
      @submit.prevent="submitForm"
      autocomplete="off"
    )
      .form-section
        h2.section-title Información General
        .form-group
          label(for="name") Nombre Completo *
          input#name.form-control(type="text", x-model="name", required, autocomplete="off")

      +phoneSection()
      +emailSection()
      +addressSection()

      .form-actions
        button.btn.btn-primary(type="submit", :disabled="loading")
          span(x-text="loading ? 'Actualizando...' : 'Actualizar Contacto'")
        a.btn.btn-outline-secondary(href="/contacts") Cancelar

block scripts
  script(src="/js/edit-contact.js")