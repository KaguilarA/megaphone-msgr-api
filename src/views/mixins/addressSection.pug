mixin addressSection()
  .form-section
    .section-header
      h2.section-title Direcciones
      button.btn.btn-secondary.btn-sm(
        type="button",
        @click="addAddress"
      ) + Agregar Dirección

    .dynamic-list
      template(x-for="(addr, index) in addresses" :key="index")
        .dynamic-row.grid-full
          .form-group
            label Calle
            input.form-control(type="text", x-model="addr.street", autocomplete="off", placeholder="Av. Central, Calle 5")
          .form-group
            label Ciudad
            input.form-control(type="text", x-model="addr.city", autocomplete="off", placeholder="San José")
          .form-group
            label Estado / Provincia
            input.form-control(type="text", x-model="addr.state", autocomplete="off", placeholder="San José")
          .form-group
            label Código Postal
            input.form-control(type="text", x-model="addr.postalCode", autocomplete="off", placeholder="10101")
          .form-group
            label País
            input.form-control(type="text", x-model="addr.country", autocomplete="off", placeholder="Costa Rica")
          button.btn.btn-outline-danger.btn-sm(
            type="button",
            @click="removeAddress(index)"
          ) Eliminar