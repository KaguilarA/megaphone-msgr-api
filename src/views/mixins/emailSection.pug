mixin emailSection()
  .form-section
    .section-header
      h2.section-title Correos Electrónicos
      button.btn.btn-secondary.btn-sm(
        type="button",
        @click="addEmail"
      ) + Agregar Correo

    .dynamic-list
      template(x-for="(email, index) in emails" :key="index")
        .dynamic-row.grid-2
          .form-group
            label Correo Electrónico
            input.form-control(
              type="email",
              x-model="email.email",
              autocomplete="off",
              placeholder="correo@ejemplo.com"
            )
          button.btn.btn-outline-danger.btn-sm(
            type="button",
            @click="removeEmail(index)"
          ) Eliminar