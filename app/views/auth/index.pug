extends ../layout

include ../mixins/formGroup
include ../mixins/button

block content
  .auth-page-wrapper(x-data="loginApp()")
    .auth-card
      .auth-card-header
        h1.auth-title Iniciar Sesión
        p.auth-subtitle Accede a tus contactos y administra tu agenda desde un solo lugar.

      form#loginForm(@submit.prevent="submitForm" autocomplete="off")
        .form-section
          +formGroup('Correo Electrónico *', 'email', 'email', { xModel: 'email' })(
            id="email"
            required
            placeholder="correo@ejemplo.com"
          )
          +formGroup('Contraseña *', 'password', 'password', { xModel: 'password' })(
            id="password"
            required
            placeholder="••••••••"
          )

        .form-actions
          +button('Iniciar Sesión', 'primary btn-full', '', 'submit', 'fas fa-sign-in-alt')(:disabled="loading")

      .auth-footer
        span ¿Aún no tienes cuenta?
        a.auth-link(href="/auth/register")
          i.fas.fa-user-plus
          |  Regístrate

block scripts
  script(src="/js/shared/forms.js")
  script(src="/js/auth/login.js")