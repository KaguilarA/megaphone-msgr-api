extends ../layout

include ../mixins/formGroup
include ../mixins/button

block content
  .auth-page-wrapper(x-data="registerApp()")
    .page-header
      h1 Registrarse

    .form-container
      form#registerForm(@submit.prevent="submitForm" autocomplete="off")
        .form-section
          +formGroup('Nombre *', 'name', 'text', { xModel: 'name' })(
            id="name"
            required
            placeholder="Ej: Juan"
          )
          +formGroup('Apellido *', 'lastname', 'text', { xModel: 'lastname' })(
            id="lastname"
            required
            placeholder="Ej: Pérez"
          )
          +formGroup('Correo Electrónico *', 'registerEmail', 'email', { xModel: 'registerEmail' })(
            id="registerEmail"
            required
            placeholder="correo@ejemplo.com"
          )
          +formGroup('Teléfono *', 'registerPhone', 'text', { xModel: 'registerPhone' })(
            id="registerPhone"
            required
            placeholder="Ej: +50612345678"
          )
          +formGroup('Contraseña *', 'password', 'password', { xModel: 'password' })(
            id="password"
            required
            placeholder="••••••••"
          )

        .form-actions
          +button('Registrarse', 'success btn-full', '', 'submit', 'fas fa-user-plus')(:disabled="loading")
          +button('Volver a Login', 'outline-secondary btn-full', '', 'button', 'fas fa-arrow-left')(@click.prevent="navigateBack()")

block scripts
  script(src="/js/shared/forms.js")
  script(src="/js/auth/register.js")
