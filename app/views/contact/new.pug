extends ../layout

include ../mixins/formGroup
include ../mixins/button
include ../mixins/phoneSelect
include ../mixins/phoneSection
include ../mixins/emailSection
include ../mixins/addressSection

block content
  .create-page-wrapper(x-data=`createContactApp(${JSON.stringify({ backUrl: backUrl || "/contact" })})`)
    .page-header
      h1 Nuevo Contacto
      +button('Volver a Contactos', 'outline-secondary')(@click="navigateBack")

    .form-container
      form#contactForm(
        @submit.prevent="submitForm"
        autocomplete="off"
      )
        .form-section
          h2.section-title Datos Personales
          +formGroup('Nombre Completo *', 'name', 'text', { xModel: 'name' })(
            id="name"
            required
            placeholder="Ej: Juan Pérez"
          )

        // Secciones dinámicas (email y address inician limpias)
        +phoneSection()
        +emailSection()
        +addressSection()

        .form-actions
          +button('Guardar Contacto', 'success', '', 'submit')(
            :disabled="loading"
          )
          
          +button('Cancelar', 'outline-secondary')(@click="navigateBack($event)")

block scripts
  script(src="/js/shared/parsers.js")
  script(src="/js/shared/countries.js")
  script(src="/js/shared/forms.js")
  script(src="/js/contacts/new.js")