extends ../layout

include ../mixins/dataTable
include ../mixins/button

block content
  .list-page-wrapper(x-data=`contactsListApp(${JSON.stringify(dataList || [])})`)
    .page-header
      h1 Lista de Contactos
      // Usamos el mixin +button para mantener consistencia semántica y de estilos
      +button('+ Agregar Contacto', 'success')(@click="navigateToAdd")

    if !dataList || dataList.length === 0
      .alert.alert-info.text-center
        p.m-0 No hay contactos registrados. ¡Comienza agregando uno nuevo!
    else
      // Barrita de Búsqueda y Paginador
      .d-flex.justify-content-between.align-items-center.mb-3
        .search-container.flex-grow-1.me-3
          input.form-control(
            type="text"
            placeholder="Buscar por nombre, correo o teléfono..."
            x-model="search"
            @input="currentPage = 1"
          )
        .d-flex.align-items-center
          label.me-2.mb-0.text-nowrap.small Mostrar:
          select.form-select.form-select-sm(
            x-model.number="perPage" 
            @change="currentPage = 1"
          )
            option(value="5") 5
            option(value="10") 10
            option(value="25") 25

      +dataTable(columns, 'paginatedList')
        +button('Editar', 'outline-primary', 'sm')(@click="navigateToEdit(item._id)")
        +button('Eliminar', 'outline-danger', 'sm')(@click="deleteContact(item._id)")

      .d-flex.justify-content-between.align-items-center.mt-3(x-show="totalPages > 1")
        span.small.text-muted
          | Mostrando página 
          strong(x-text="currentPage") 
          |  de 
          strong(x-text="totalPages")

        .btn-group
          +button('Anterior', 'outline-secondary', 'sm')(
            :disabled="currentPage === 1"
            @click="setPage(currentPage - 1)"
          )
          +button('Siguiente', 'outline-secondary', 'sm')(
            :disabled="currentPage === totalPages"
            @click="setPage(currentPage + 1)"
          )

block scripts
  script(src="/js/contacts.js")