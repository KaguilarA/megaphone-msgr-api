mixin dataTable(columnsConfig = [], dataList = 'paginatedList')
  .table-container(x-show="filteredList.length > 0")
    table.data-table
      thead
        tr
          each col in columnsConfig
            if col.sortable
              th.sortable(@click=`sort('${col.key}')` style="cursor: pointer;")
                span= col.label + ' '
                span(x-show=`sortBy === '${col.key}'`)
                  span(x-text="sortAsc ? '▲' : '▼'")
            else
              th= col.label

          if block
            th.text-end Acciones

      tbody
        template(x-for=`item in ${dataList}` :key="item._id || item.id")
          tr
            each col in columnsConfig
              td
                case col.type
                  when 'list'
                    // Para Renderizar Arrays/Listas
                    template(x-if=`item.${col.key} && item.${col.key}.length > 0`)
                      ul.list-unstyled.m-0
                        template(x-for=`subItem in item.${col.key}`)
                          li(x-text=`subItem.${col.subKey || 'name'} || subItem`)
                    template(x-if=`!item.${col.key} || item.${col.key}.length === 0`)
                      span.text-muted —
                  when 'data'
                    // Para Renderizar Objects
                    template(x-if=`item.${col.key} && item.${col.key}.${col.subKey}`)
                      ul.list-unstyled.m-0
                        li(x-text=`item.${col.key}.${col.subKey}`)
                    template(x-if=`!item.${col.key} && item.${col.key}.${col.subKey}`)
                      span.text-muted —
                  default 
                    // Texto plano o valor por defecto
                    span(x-text=`item.${col.key} || '—'`)


            if block
              td.actions-cell
                block