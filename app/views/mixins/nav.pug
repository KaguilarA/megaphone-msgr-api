mixin mainNav()
  header.main-header
    .container.header-content
      a.brand(href="/") WhatsApp AMP
      nav.main-nav
        ul.nav-list
          li.nav-item
            a.nav-link(href="/contact") Contactos
          li.nav-item
            a.nav-link(href="/user") Usuarios
          li.nav-item
            a.nav-link.nav-link--accent(href="/auth") Login
