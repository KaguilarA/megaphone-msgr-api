include ./phoneSelect
include ./button
include ./formGroup

mixin phoneSection()
  .form-section
    .section-header
      h2.section-title Teléfonos *
      +button('+ Agregar Teléfono', 'secondary', 'sm')(@click="addPhone")

    .dynamic-list
      template(x-for="(phone, index) in phones" :key="index")
        .dynamic-row.grid-3
          +countryCodeSelect('phone.countryNumber', true)

          +formGroup('Número de Teléfono *', '', 'text', { 
            placeholder: '88888888', 
            xModel: 'phone.phone' 
          })(required)

          +button('Eliminar', 'outline-danger', 'sm')(
            @click="removePhone(index)",
            x-show="phones.length > 1"
          )