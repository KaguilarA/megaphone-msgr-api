include ./button
include ./formGroup

mixin addressSection(hideAdd = false)
  
  .form-section
    .section-header
      h2.section-title Direcciones 
      if(!hideAdd)
        +button('+ Agregar Dirección', 'secondary', 'sm')(@click="addAddress")

    .dynamic-list
      template(x-for="(addr, index) in addresses" :key="index")
        .dynamic-row.grid-full
          +formGroup('Calle', '', 'text', { placeholder: 'Av. Central, Calle 5', xModel: 'addr.street' })
          +formGroup('Ciudad', '', 'text', { placeholder: 'San José', xModel: 'addr.city' })
          +formGroup('Estado / Provincia', '', 'text', { placeholder: 'San José', xModel: 'addr.state' })
          +formGroup('Código Postal', '', 'text', { placeholder: '10101', xModel: 'addr.postalCode' })
          +formGroup('País', '', 'text', { placeholder: 'Costa Rica', xModel: 'addr.country' })
          
          +button('Eliminar', 'outline-danger', 'sm')(@click="removeAddress(index)")