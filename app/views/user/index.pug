extends ../layout

include ../mixins/button
include ../mixins/nav

block content
  +mainNav()
  main.container
    .profile-page-wrapper(x-data=`usersListApp(${JSON.stringify(user)})`)
      .page-header
        h1 Mi Perfil
        .header-actions
          +button('Editar Perfil', 'primary', '', 'button')(onclick="window.location.href='/user/me/edit'")
          +button('Asignar Token', 'outline-primary', '', 'button')(@click="navigateToToken()")

      .profile-grid
        .profile-card
          h2.section-title Datos Personales
          ul.profile-list
            li
              strong Nombre:
              span #{user.name}
            li
              strong Apellido:
              span #{user.lastname}
            li
              strong Correo:
              span #{(user.email && user.email.email) || 'No disponible'}
            li
              strong Teléfono:
              span #{(user.phoneNumber && user.phoneNumber.phone) || 'No disponible'}

        .profile-card
          h2.section-title Integraciones
          ul.profile-list
            li
              strong Email Token:
              span #{user.emailToken || 'No asignado'}
            li
              strong WhatsApp Token:
              span #{user.waToken || 'No asignado'}
            li
              strong Telegram Token:
              span #{user.telegramToken || 'No asignado'}

        .profile-card
          h2.section-title Direcciones
          if user.addresses && user.addresses.length > 0
            ul.profile-list
              each address in user.addresses
                li
                  span #{address.street}, #{address.city}, #{address.state}, #{address.postalCode}, #{address.country}
          else
            p.text-muted No hay direcciones registradas.

block scripts
  script(src="/js/shared/baseList.js")
  script(src="/js/users/index.js")
