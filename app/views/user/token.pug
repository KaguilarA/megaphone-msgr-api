extends ../layout

include ../mixins/formGroup
include ../mixins/button
include ../mixins/nav
    

block content
  +mainNav()
  main.container
    .edit-page-wrapper(x-data=`userTokenApp(${JSON.stringify(user)})`)
      .page-header
        h1 Asignar Token al Usuario
        +button('Volver a Perfil', 'outline-secondary')(@click="navigateBack()")

      .form-container
        form#tokenForm(@submit.prevent="submitForm" autocomplete="off")
          .form-section
            h2.section-title Tokens de Integración
            p.text-muted.mb-3
              | Aquí puedes crear o actualizar los tokens asociados a tu cuenta.
            +formGroup('Token de Correo (emailToken)', 'emailToken', 'text', { xModel: 'emailToken' })(
              id="emailToken"
              placeholder="Ingresa el token de correo"
            )
            +formGroup('Token de WhatsApp (waToken)', 'waToken', 'text', { xModel: 'waToken' })(
              id="waToken"
              placeholder="Ingresa el token de WhatsApp"
            )
            +formGroup('Token de Telegram (telegramToken)', 'telegramToken', 'text', { xModel: 'telegramToken' })(
              id="telegramToken"
              placeholder="Ingresa el token de Telegram"
            )

          .form-actions
            +button('Guardar Tokens', 'success', '', 'submit')(
              :disabled="loading"
            )
            +button('Cancelar', 'outline-secondary')(@click="navigateBack()")

block scripts
  script(src="/js/shared/forms.js")
  script(src="/js/users/token.js")
