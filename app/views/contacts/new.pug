extends ../layout

include ../mixins/formGroup
include ../mixins/button
include ../mixins/phoneSelect
include ../mixins/phoneSection
include ../mixins/emailSection
include ../mixins/addressSection

block content
  .create-page-wrapper(x-data="createContactApp()")
    .page-header
      h1 Nuevo Contacto
      +button('Volver a Contactos', 'outline-secondary')(@click="navigateBack($event)")

    .form-container
      form#contactForm(
        @submit.prevent="submitForm"
        autocomplete="off"
      )
        .form-section
          h2.section-title Datos Personales
          +formGroup('Nombre Completo *', 'name', 'text', { xModel: 'name' })(
            id="name"
            required
            placeholder="Ej: Juan Pérez"
          )

        // Secciones dinámicas (email y address inician limpias)
        +phoneSection()
        +emailSection()
        +addressSection()

        .form-actions
          +button('', 'success', '', 'submit')(
            :disabled="loading"
          )
            span(x-text="loading ? 'Guardando...' : 'Guardar Contacto'")
          
          +button('Cancelar', 'outline-secondary')(@click="navigateBack($event)")

block scripts
  script(src="/js/shared/forms.js")
  script(type="module" src="/js/create-contact.js")