{
  "name": "megaphone-msgr-api",
  "version": "1.0.0",
  "description": "API for the Megaphone Messenger application",
  "homepage": "https://github.com/KaguilarA/megaphone-msgr-api#readme",
  "bugs": {
    "url": "https://github.com/KaguilarA/megaphone-msgr-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaguilarA/megaphone-msgr-api.git"
  },
  "type": "module",
  "main": "index.ts",
  "license": "UNLICENSED",
  "private": true,
  "author": {
    "name": "Kevin Aguilar",
    "email": "kevin.231@hotmail.com",
    "url": "https://github.com/KaguilarA"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "setup": "node --env-file-if-exists=.env --import tsx scripts/setup.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch index.ts",
    "start": "node --env-file-if-exists=.env --import tsx index.ts",
    "test": "node --import tsx --import ./utils/testSetup.js --test",
    "migrate:phones": "node --env-file-if-exists=.env --import tsx scripts/migrate-phone-numbers.ts",
    "build": "node scripts/build-backend.mjs",
    "build:worker": "node scripts/build-worker.mjs"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "country-codes-flags-phone-codes": "^1.1.1",
    "express": "^5.2.1",
    "mongoose": "^8.24.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.0",
    "owl-expressjs-utils": "^1.0.3",
    "read-excel-file": "^9.3.17",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "mongoose": "$mongoose"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "es-module-lexer": "2.0.0",
    "fflate": "^0.8.3",
    "javascript-obfuscator": "5.10.1",
    "mongodb-memory-server": "^11.3.0",
    "terser": "5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
